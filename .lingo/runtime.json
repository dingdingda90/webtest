{
  "schemaVersion": 1,
  "projectType": "fullstack",
  "services": [
    {
      "name": "web",
      "role": "frontend",
      "cwd": "frontend",
      "port": 5173,
      "startCommand": "npx vite --port 5173 --host 0.0.0.0 --strictPort",
      "preview": true
    },
    {
      "name": "api",
      "role": "backend",
      "cwd": "backend",
      "port": 8000,
      "startCommand": ".venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "healthCheck": { "type": "http", "path": "/api/health" }
    }
  ],
  "checkCommand": "npm run check"
}
